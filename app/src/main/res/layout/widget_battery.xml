<?xml version="1.0" encoding="utf-8"?>
<!--
  バッテリー残量ウィジェット用レイアウト（RemoteViews）

  【RemoteViewsの制約（重要・教訓 feedback_widget_remoteviews）】
  - <View> は使えない → 区切り線・スペーサーは <TextView> で代用
  - カスタムView/<RecyclerView>不可
  - 使えるのは TextView / ImageView / LinearLayout / FrameLayout / RelativeLayout / Button 等限定

  【構成】
  - 横並び：左に大きな残量%、右に充電アイコン(⚡)
  - 下に次のアラート閾値テキスト
  - ダーク/ライト両対応のため、背景は半透明黒(#88000000)、文字は白で固定
    （ウィジェットはホーム画面の背景に乗るため、システムテーマでなく自前固定が読みやすい）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- 上段：残量% + 充電アイコン -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- バッテリー残量（大きな数字） -->
        <TextView
            android:id="@+id/widget_battery_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:text="--%" />

        <!-- 充電中アイコン（⚡）。非充電中は空文字にして見えなくする -->
        <TextView
            android:id="@+id/widget_charge_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#FFFFEB3B"
            android:paddingStart="6dp"
            android:gravity="center"
            android:text="" />
    </LinearLayout>

    <!-- 下段：次のアラート閾値 -->
    <TextView
        android:id="@+id/widget_next_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FFCCCCCC"
        android:gravity="center"
        android:paddingTop="2dp"
        android:text="アラート未設定" />

</LinearLayout>
